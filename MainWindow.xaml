<Window x:Class="InternetMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternetMonitor"
        Title="网络监控" Width="420" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual" ShowInTaskbar="True"
        FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="7" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource WinBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="7" />
                            <Border x:Name="Hover" Background="#E5484D" CornerRadius="7" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Legend" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeLabel}" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatNumber" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
            MouseLeftButtonDown="Window_MouseLeftButtonDown">
        <Grid Margin="28,18,28,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent">
                <TextBlock Text="网络监控" FontSize="11" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Style="{StaticResource WinBtn}" Content="&#xE713;"
                            AutomationProperties.Name="设置"
                            Click="Settings_Click" Margin="0,0,1,0" ToolTip="设置" />
                    <Button x:Name="PinButton" Style="{StaticResource WinBtn}" Content="&#xE840;"
                            AutomationProperties.Name="置顶"
                            Click="Pin_Click" Margin="0,0,1,0" ToolTip="窗口置顶" />
                    <Button Style="{StaticResource WinBtn}" Content="&#xE921;"
                            AutomationProperties.Name="最小化"
                            Click="Minimize_Click" Margin="0,0,1,0" ToolTip="最小化" />
                    <Button Style="{StaticResource CloseBtn}" Content="&#xE8BB;"
                            AutomationProperties.Name="关闭"
                            Click="Close_Click" ToolTip="关闭到托盘" />
                </StackPanel>
            </Grid>

            <!-- 实时速率 -->
            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentDown}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="下载" Style="{StaticResource Legend}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock x:Name="RxValue" Text="0" FontSize="{DynamicResource FontSizeValue}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="RxUnit" Text="B/s" FontSize="{DynamicResource FontSizeUnit}"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Bottom" Margin="5,0,0,5" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentUp}"
                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="上传" Style="{StaticResource Legend}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <TextBlock x:Name="TxValue" Text="0" FontSize="{DynamicResource FontSizeValue}"
                                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Bottom"
                                   Typography.NumeralAlignment="Tabular" />
                        <TextBlock x:Name="TxUnit" Text="B/s" FontSize="{DynamicResource FontSizeUnit}"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Bottom" Margin="5,0,0,5" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 速率曲线 -->
            <local:SpeedChart x:Name="Chart" Grid.Row="2" Height="72" Margin="0,20,0,0" />

            <Rectangle Grid.Row="3" Height="1" Fill="{DynamicResource BorderBrushSoft}" Margin="0,18,0,0" />

            <!-- 流量用量 -->
            <StackPanel Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="流量用量" FontSize="{DynamicResource FontSizeLabel}" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondary}" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="今日" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentDown}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 1.2 L5 8.8 M1.9 5.9 L5 8.8 L8.1 5.9" />
                            <TextBlock x:Name="TodayRxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentUp}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 8.8 L5 1.2 M1.9 4.1 L5 1.2 L8.1 4.1" />
                            <TextBlock x:Name="TodayTxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="本周" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentDown}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 1.2 L5 8.8 M1.9 5.9 L5 8.8 L8.1 5.9" />
                            <TextBlock x:Name="WeekRxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentUp}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 8.8 L5 1.2 M1.9 4.1 L5 1.2 L8.1 4.1" />
                            <TextBlock x:Name="WeekTxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="本月" Style="{StaticResource StatLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentDown}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 1.2 L5 8.8 M1.9 5.9 L5 8.8 L8.1 5.9" />
                            <TextBlock x:Name="MonthRxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Path Width="10" Height="10" Stretch="None" VerticalAlignment="Center" Margin="0,0,5,0"
                                  Stroke="{DynamicResource AccentUp}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Data="M5 8.8 L5 1.2 M1.9 4.1 L5 1.2 L8.1 4.1" />
                            <TextBlock x:Name="MonthTxText" Style="{StaticResource StatNumber}"
                                       Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- 最近 7 天柱状图 -->
            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="近 7 天" FontSize="{DynamicResource FontSizeFooter}" Foreground="{DynamicResource TextMuted}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <local:UsageBars x:Name="Bars" Grid.Column="1" Height="26"
                                 ToolTip="最近 7 天流量：下方为下载，上方为上传" />
            </Grid>

            <!-- 页脚 -->
            <Grid Grid.Row="6" Margin="0,16,0,0">
                <TextBlock x:Name="PeakText" Text="峰值 ↓ 0 B/s   ↑ 0 B/s"
                           FontSize="10" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="#3DD68C" Margin="0,0,6,0" />
                    <TextBlock Text="实时" FontSize="10" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

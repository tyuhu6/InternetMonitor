<UserControl x:Class="InternetMonitor.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:InternetMonitor"
             FontFamily="{DynamicResource AppFontFamily}">

    <UserControl.Resources>
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                            <Border x:Name="Ring" CornerRadius="5" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource TextPrimary}" Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 外边距留给柔和投影 -->
    <Border Margin="10" CornerRadius="14" Padding="12"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.32" Color="#000000" />
        </Border.Effect>

        <StackPanel Width="212">
            <local:SatValBox x:Name="SvBox" Height="118" />
            <local:HueBar x:Name="HueBar" Height="10" Margin="0,12,0,0" />

            <Grid Margin="0,14,0,0">
                <Border x:Name="PreviewChip" Width="26" Height="26" CornerRadius="8"
                        HorizontalAlignment="Left" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrushSoft}" />
                <Border Width="106" Height="26" Margin="34,0,0,0" HorizontalAlignment="Left"
                        CornerRadius="8" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrushSoft}">
                    <TextBox x:Name="HexBox" Background="Transparent" BorderThickness="0"
                             Padding="9,0" MaxLength="7" FontSize="11"
                             VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             SelectionBrush="{DynamicResource AccentDown}"
                             AutomationProperties.Name="颜色值"
                             KeyDown="HexBox_KeyDown" LostFocus="HexBox_LostFocus" />
                </Border>
                <TextBlock x:Name="HintText" Text="HEX" FontSize="9.5"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <UniformGrid Columns="10" Margin="0,14,0,0">
                <Button Style="{StaticResource PresetBtn}" Background="#4C9AFF" Tag="#4C9AFF"
                        AutomationProperties.Name="预设 4C9AFF" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#3DD68C" Tag="#3DD68C"
                        AutomationProperties.Name="预设 3DD68C" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#22D3EE" Tag="#22D3EE"
                        AutomationProperties.Name="预设 22D3EE" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#A78BFA" Tag="#A78BFA"
                        AutomationProperties.Name="预设 A78BFA" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#F472B6" Tag="#F472B6"
                        AutomationProperties.Name="预设 F472B6" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#F0A63A" Tag="#F0A63A"
                        AutomationProperties.Name="预设 F0A63A" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#E5484D" Tag="#E5484D"
                        AutomationProperties.Name="预设 E5484D" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#94A3B8" Tag="#94A3B8"
                        AutomationProperties.Name="预设 94A3B8" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#E8EAF0" Tag="#E8EAF0"
                        AutomationProperties.Name="预设 E8EAF0" Click="Preset_Click" />
                <Button Style="{StaticResource PresetBtn}" Background="#14161C" Tag="#14161C"
                        AutomationProperties.Name="预设 14161C" Click="Preset_Click" />
            </UniformGrid>
        </StackPanel>
    </Border>
</UserControl>

<Window x:Class="InternetMonitor.TaskbarSpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" IsHitTestVisible="False"
        WindowStartupLocation="Manual" FontFamily="{DynamicResource AppFontFamily}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Border Padding="7,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Viewbox x:Name="DownIconBox" Width="9" Height="9" VerticalAlignment="Center">
                <Path x:Name="DownIcon" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4.5 1 L4.5 8 M1.6 5.1 L4.5 8 L7.4 5.1" />
            </Viewbox>
            <TextBlock x:Name="DownText" Text="0B/s" Margin="4,0,0,0" FontSize="11"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />

            <Viewbox x:Name="UpIconBox" Width="9" Height="9" Margin="10,0,0,0" VerticalAlignment="Center">
                <Path x:Name="UpIcon" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="M4.5 8 L4.5 1 M1.6 3.9 L4.5 1 L7.4 3.9" />
            </Viewbox>
            <TextBlock x:Name="UpText" Text="0B/s" Margin="4,0,0,0" FontSize="11"
                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
        </StackPanel>
    </Border>
</Window>

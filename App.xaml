<Application x:Class="InternetMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- 以下默认值会在启动时被用户配置覆盖（Appearance.Apply） -->
        <FontFamily x:Key="AppFontFamily">Microsoft YaHei UI</FontFamily>
        <SolidColorBrush x:Key="BgBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#F7F7F8" />
        <SolidColorBrush x:Key="HoverBrush" Color="#12000000" />
        <SolidColorBrush x:Key="BorderBrushSoft" Color="#E9EBEF" />
        <SolidColorBrush x:Key="SwitchTrack" Color="#E6E7EA" />
        <SolidColorBrush x:Key="TextPrimary" Color="#101318" />
        <SolidColorBrush x:Key="TextSecondary" Color="#6E737C" />
        <SolidColorBrush x:Key="TextMuted" Color="#A0A4AB" />
        <SolidColorBrush x:Key="AccentDown" Color="#2F6BFF" />
        <SolidColorBrush x:Key="AccentUp" Color="#E8890C" />

        <sys:Double x:Key="FontSizeTitle">12</sys:Double>
        <sys:Double x:Key="FontSizeValue">28</sys:Double>
        <sys:Double x:Key="FontSizeUnit">11</sys:Double>
        <sys:Double x:Key="FontSizeLabel">11</sys:Double>
        <sys:Double x:Key="FontSizeSmall">10.5</sys:Double>
        <sys:Double x:Key="FontSizeFooter">10.5</sys:Double>

        <!-- 极简滚动条：无箭头、无边框，细条 + 悬停加深 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="MinWidth" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb MinHeight="28">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bar" CornerRadius="3"
                                                        Background="{DynamicResource TextMuted}" Opacity="0.3" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter Property="Height" Value="6" />
                                <Setter Property="MinHeight" Value="6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>

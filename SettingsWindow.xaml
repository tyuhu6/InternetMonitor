<Window x:Class="InternetMonitor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InternetMonitor"
        Title="设置" Width="400" SizeToContent="Height" MaxHeight="660"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="{DynamicResource AppFontFamily}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Base" Background="{TemplateBinding Background}" CornerRadius="8" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="8" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SwitchTrack}">
                            <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource TextMuted}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentDown}" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" To="16" Duration="0:0:0.16"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" To="0" Duration="0:0:0.16"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepperBtn" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Base" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="8" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="10"
                                    Margin="-4" Opacity="0" />
                            <ContentPresenter />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="9" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{DynamicResource TextPrimary}" CornerRadius="9" />
                            <Border x:Name="Hover" Background="#1FFFFFFF" CornerRadius="9" Opacity="0" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="3,1">
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SwitchTrack}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SwitchTrack}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="172" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboItem}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1" />
                            <Border x:Name="Hover" Background="{DynamicResource HoverBrush}" CornerRadius="8" Opacity="0" />
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="11,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,11,0" Foreground="{DynamicResource TextSecondary}"
                                       IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" StaysOpen="False"
                                   Placement="Bottom" VerticalOffset="6" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
                                        CornerRadius="10" Margin="0,0,6,8" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="250">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.3" Color="#000000" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Margin" Value="0,20,0,8" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Hairline" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource BorderBrushSoft}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{DynamicResource BgBrush}"
            BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1"
            PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="48" Margin="20,0,14,0" Background="Transparent">
                <TextBlock Text="设置" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Button Style="{StaticResource WinBtn}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Close_Click" AutomationProperties.Name="关闭" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
                <StackPanel>
                    <TextBlock Text="显示" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />

                    <Grid Height="38">
                        <TextBlock Text="显示主监控窗口" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="MainWindowSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="显示主监控窗口"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="MainWindowSwitch_Changed" Unchecked="MainWindowSwitch_Changed" />
                    </Grid>

                    <Grid Height="38">
                        <TextBlock Text="在任务栏显示网速" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="TaskbarSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="在任务栏显示网速"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="TaskbarSwitch_Changed" Unchecked="TaskbarSwitch_Changed" />
                    </Grid>

                    <Grid Height="38">
                        <TextBlock Text="窗口始终置顶" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="TopmostSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="窗口始终置顶"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="TopmostSwitch_Changed" Unchecked="TopmostSwitch_Changed" />
                    </Grid>

                    <Grid Height="38">
                        <TextBlock Text="开机自动启动" Style="{StaticResource RowLabel}" />
                        <ToggleButton x:Name="StartupSwitch" Style="{StaticResource Switch}"
                                      AutomationProperties.Name="开机自动启动"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="StartupSwitch_Changed" Unchecked="StartupSwitch_Changed" />
                    </Grid>

                    <Rectangle Style="{StaticResource Hairline}" Margin="0,16,0,0" />
                    <TextBlock Text="外观" Style="{StaticResource SectionLabel}" />

                    <Grid Height="38">
                        <TextBlock Text="字体" Style="{StaticResource RowLabel}" />
                        <ComboBox x:Name="FontCombo" Style="{StaticResource DarkCombo}"
                                  AutomationProperties.Name="字体"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  SelectionChanged="FontCombo_SelectionChanged" />
                    </Grid>

                    <Grid Height="38">
                        <TextBlock Text="字号" Style="{StaticResource RowLabel}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="FontMinus" Style="{StaticResource StepperBtn}" Content="&#xE738;"
                                    AutomationProperties.Name="减小字号" Click="FontMinus_Click" />
                            <TextBlock x:Name="FontScaleText" Text="100%" Width="62" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <Button x:Name="FontPlus" Style="{StaticResource StepperBtn}" Content="&#xE710;"
                                    AutomationProperties.Name="增大字号" Click="FontPlus_Click" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Style="{StaticResource Hairline}" Margin="0,16,0,0" />
                    <TextBlock Text="颜色" Style="{StaticResource SectionLabel}" />

                    <Grid Height="40">
                        <TextBlock Text="背景颜色" Style="{StaticResource RowLabel}" />
                        <Button x:Name="BgColorButton" Style="{StaticResource SwatchBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="BgColor_Click" AutomationProperties.Name="背景颜色">
                            <Border x:Name="BgSwatch" Width="52" Height="24" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>

                    <Grid Height="40">
                        <TextBlock Text="文字颜色" Style="{StaticResource RowLabel}" />
                        <Button x:Name="TextColorButton" Style="{StaticResource SwatchBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="TextColor_Click" AutomationProperties.Name="文字颜色">
                            <Border x:Name="TextSwatch" Width="52" Height="24" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>

                    <Grid Height="40">
                        <TextBlock Text="下载颜色" Style="{StaticResource RowLabel}" />
                        <Button x:Name="DownColorButton" Style="{StaticResource SwatchBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="DownColor_Click" AutomationProperties.Name="下载颜色">
                            <Border x:Name="DownSwatch" Width="52" Height="24" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>

                    <Grid Height="40">
                        <TextBlock Text="上传颜色" Style="{StaticResource RowLabel}" />
                        <Button x:Name="UpColorButton" Style="{StaticResource SwatchBtn}" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Click="UpColor_Click" AutomationProperties.Name="上传颜色">
                            <Border x:Name="UpSwatch" Width="52" Height="24" CornerRadius="7"
                                    BorderThickness="1" BorderBrush="{DynamicResource TextMuted}" />
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="20,18,20,18">
                <Button Style="{StaticResource GhostBtn}" Content="恢复默认" HorizontalAlignment="Left"
                        Click="Reset_Click" AutomationProperties.Name="恢复默认" />
                <Button Style="{StaticResource PrimaryBtn}" Content="完成" HorizontalAlignment="Right"
                        Click="Close_Click" AutomationProperties.Name="完成" />
            </Grid>

            <Popup x:Name="ColorPopup" AllowsTransparency="True" StaysOpen="False" Placement="Bottom"
                   PopupAnimation="Fade" HorizontalOffset="-202" VerticalOffset="4">
                <local:ColorPicker x:Name="Picker" />
            </Popup>
        </Grid>
    </Border>
</Window>
